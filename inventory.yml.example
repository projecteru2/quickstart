# Addresses below are documentation examples (RFC 5737); replace them with your own.
all:
  children:
    etcd:
      hosts:
        192.0.2.11:
          etcd_name: etcd0
        192.0.2.12:
          etcd_name: etcd1
        192.0.2.13:
          etcd_name: etcd2
      vars:
        etcd_version: v3.6.14

    core:
      hosts:
        192.0.2.11:

    node_docker:
      hosts:
        192.0.2.11:
          node_docker_name: node-192-0-2-11
        192.0.2.12:
          node_docker_name: node-192-0-2-12
        192.0.2.13:
          node_docker_name: node-192-0-2-13

  vars:
    ansible_user: root
