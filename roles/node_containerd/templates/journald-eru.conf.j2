# Workload output reaches journald under SYSLOG_IDENTIFIER=eru, from the log
# shim containerd runs and from the transient units process workloads become.
# journald rate-limits per service rather than per identifier, so the limits are
# raised for the whole journal.
[Journal]
RateLimitIntervalSec={{ node_containerd_journal_rate_limit_interval }}
RateLimitBurst={{ node_containerd_journal_rate_limit_burst }}
